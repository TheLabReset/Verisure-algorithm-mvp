  darkPurple:  '#XXXXXX',  // hover (≥4,5:1 sobre blanco obligatorio)
  lightPurple: '#XXXXXX',  // tint — solo sobre fondos oscuros
  charcoal:    '#XXXXXX',  // fondo página o dark surface
  slate:       '#XXXXXX',  // fondo cards
  darkSlate:   '#XXXXXX',  // superficie alternativa
  cyan:        '#06B6D4',  // datos/info — mantener o ajustar si hay conflicto de marca
  electric:    '#22D3EE',  // datos secundarios
  emerald:     '#10B981',  // positivo/éxito
  green:       '#22C55E',  // secundario positivo
  lime:        '#84CC16',  // secundario positivo 2
  red:         '#EF4444',  // alerta/error
  amber:       '#XXXXXX',  // advertencia / CTA secundario warm
  orange:      '#XXXXXX',  // alias accent o CTA secundario
  darkOrange:  '#XXXXXX',  // hover orange
