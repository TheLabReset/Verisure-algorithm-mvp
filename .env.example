# ============================================================================
# The Algorithm by Reset (Verisure Perú) — variables de entorno
# ============================================================================
# Copia este archivo a .env y completa con valores reales. NUNCA commitees .env.
# La app funciona sin credenciales en modo fixtures (VITE_DATA_SOURCE=fixtures).
# ============================================================================

# === FUENTE DE DATOS ===
# fixtures (default, sin credenciales) | live (Integrametrics real)
VITE_DATA_SOURCE=fixtures

# === INTEGRAMETRICS (para source=live; usado por el pipeline, no en el cliente) ===
# Base: https://pe.integra-metrics.com/api/rest/v1 · Header: Authorization: Bearer <token>
INTEGRAMETRICS_TOKEN=

# === ANTHROPIC (MAIA: Daily Brief + chat; usado por la Netlify Function, nunca client-side) ===
ANTHROPIC_API_KEY=

# === MAIA CHAT ===
# demo (default): MAIA responde desde la data derivada del día (motor local, sin latencia).
# live: el chat delega en /api/maia (Netlify Function que proxea Anthropic con la key de arriba).
VITE_MAIA_CHAT=demo

# === REGIONAL ===
REGION=PE
TIMEZONE=America/Lima
