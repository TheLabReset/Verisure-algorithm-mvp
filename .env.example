# The Algorithm · Verisure Perú: variables de entorno. Copiar a .env y completar. Nunca se commitea .env.

# Integrametrics: lo usa solo el pipeline (Node), nunca el navegador.
# En GitHub va en Settings → Secrets and variables → Actions. Sin token, el pipeline falla en rojo.
INTEGRAMETRICS_TOKEN=

# Acceso al sitio (Basic Auth): se configuran en Netlify, no en el bundle.
# Con las dos definidas, la Edge Function pide clave en todo el sitio; sin ellas, queda abierto.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
